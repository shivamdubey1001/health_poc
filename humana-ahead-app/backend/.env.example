APP_NAME=Humana Ahead API
API_PREFIX=/api
DATABASE_URL=sqlite:///./humana_ahead.db
DATA_DIR=../data
FRONTEND_ORIGIN=http://localhost:5173

USE_MOCK_AI=true
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

CARE_INTENT_THRESHOLD=0.70
RECENT_CALL_LIMIT=6
CLAIM_LOOKBACK_MONTHS=12
ENABLE_TRANSCRIPT_FALLBACK=true

# Prototype assumptions only, not vendor quotes.
INPUT_COST_PER_M_TOKENS=0.50
OUTPUT_COST_PER_M_TOKENS=2.00
