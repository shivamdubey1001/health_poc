APP_NAME=Humana Ahead API
API_PREFIX=/api
DATABASE_URL=sqlite:///./humana_ahead.db
DATA_DIR=../data
FRONTEND_ORIGIN=http://localhost:5173

# Humana Ahead now uses the real OpenAI Responses API.
# Copy this file to .env and paste your key below. Never put this key in frontend/.env.
USE_MOCK_AI=false
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

CARE_INTENT_THRESHOLD=0.70
RECENT_CALL_LIMIT=6
CLAIM_LOOKBACK_MONTHS=12
ENABLE_TRANSCRIPT_FALLBACK=true
MAX_SCAN_BATCH=25

# Session cost estimator. Update if you change model/pricing.
INPUT_COST_PER_M_TOKENS=2.00
OUTPUT_COST_PER_M_TOKENS=12.00
DATA_AS_OF=2026-08-29
